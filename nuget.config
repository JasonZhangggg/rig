<?xml version="1.0" encoding="utf-8"?>
<!-- RigHelper's packages come from nuget.org, even where a fresh .NET install has no package source set up. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
