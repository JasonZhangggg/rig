<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rig's elevated helper: sensors (LibreHardwareMonitor), inventory (WMI)
       and the fix catalog. In service mode it is also Rig's background recorder.
       Windows only; builds anywhere with EnableWindowsTargeting. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.3</Version>
    <AssemblyName>RigHelper</AssemblyName>
    <RootNamespace>Rig.Helper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Small memory use matters most for the background recorder, which never stops:
         one garbage collector thread instead of a background one, and give memory back sooner. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.2" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.2" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\packages\core\src\rules\commands.json" LogicalName="Rig.Rules.commands.json" />
    <EmbeddedResource Include="..\..\packages\core\src\rules\vectors.json" LogicalName="Rig.Rules.vectors.json" />
    <EmbeddedResource Include="..\..\packages\core\src\rules\reads.json" LogicalName="Rig.Rules.reads.json" />
    <EmbeddedResource Include="..\..\packages\core\src\rules\gpu.json" LogicalName="Rig.Rules.gpu.json" />
    <EmbeddedResource Include="..\..\packages\core\src\rules\firmware.json" LogicalName="Rig.Rules.firmware.json" />
    <EmbeddedResource Include="..\..\packages\core\src\rules\protections.json" LogicalName="Rig.Rules.protections.json" />
    <EmbeddedResource Include="..\..\packages\core\src\rules\logs.json" LogicalName="Rig.Rules.logs.json" />
    <EmbeddedResource Include="CommandAst.ps1" LogicalName="Rig.Commands.CommandAst.ps1" />
  </ItemGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
  <ItemGroup>
    <!-- The typed fixes' own rules (registry places, power settings), shared with packages/core/src/actions.ts. -->
    <EmbeddedResource Include="..\..\packages\core\src\rules\fixes.json" LogicalName="Rig.Rules.fixes.json" />
  </ItemGroup>
</Project>
