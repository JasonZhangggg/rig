{
  "name": "@rig/server",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "description": "Rig's server: accounts, PC sync and chat. Runs on Cloudflare Workers with Postgres.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "auth:schema": "vite-node scripts/auth-schema.ts",
    "db:migrate": "vite-node scripts/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@rig/core": "workspace:*",
    "better-auth": "^1.7.25",
    "hono": "^4.13.19",
    "kysely": "0.29.9",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9",
    "wrangler": "^4.163.0"
  }
}
