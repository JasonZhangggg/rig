{
  "name": "rig",
  "private": true,
  "version": "0.1.2",
  "description": "Rig, a helper app that reads, explains and fixes PCs and laptops.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:web": "pnpm --filter @rig/web dev",
    "dev:server": "pnpm --filter @rig/server dev",
    "dev:desktop": "pnpm --filter @rig/desktop tauri dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test tools/version.test.mjs && pnpm -r test",
    "version:set": "node tools/version.mjs set",
    "version:check": "node tools/version.mjs check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "postcss": "^8.5.33"
  }
}
