  "secretProperty": ["password", "passwd", "credential", "secret", "token", "productkey"],
  "registryClean": [
    { "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control" },
    { "key": "HKLM\\SYSTEM\\CurrentControlSet\\Services", "values": ["Start", "Type", "ErrorControl", "DelayedAutostart"] },
    { "key": "HKLM\\SOFTWARE\\Policies" },
    { "key": "HKCU\\Software\\Policies" },
    { "key": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies" },
    { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies" },
    { "key": "HKCU\\Control Panel" },
    { "key": "HKLM\\HARDWARE\\DESCRIPTION\\System" },
    { "key": "HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion", "values": ["ProductName", "DisplayVersion", "ReleaseId", "CurrentBuild", "CurrentBuildNumber", "UBR", "EditionID", "InstallationType"] },
    { "key": "HKCU\\Software\\Microsoft\\GameBar" },
    { "key": "HKCU\\System\\GameConfigStore" },
    { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\GameDVR" },
    { "key": "HKCU\\Software\\Microsoft\\DirectX" },
    { "key": "HKLM\\SOFTWARE\\Microsoft\\DirectX" },
    { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize" },
    { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects" },
    { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced" }
  ],
  "registryNever": [
    { "says": "Rig never reads the Windows account database or its secrets", "keys": ["HKLM\\SAM", "HKLM\\SECURITY", "SYSTEM\\CurrentControlSet\\Control\\Lsa\\Secrets"] },
    { "says": "Rig never reads the Windows sign-in settings, which can hold a saved password", "keys": ["Microsoft\\Windows NT\\CurrentVersion\\Winlogon"] },
    { "says": "Rig never reads saved remote sign-ins (PuTTY, WinSCP, VNC, Remote Desktop)", "keys": ["SimonTatham\\PuTTY", "Martin Prikryl", "RealVNC", "TightVNC", "ORL\\WinVNC3", "uvnc bvba", "UltraVNC", "Microsoft\\Terminal Server Client"] },
    { "says": "Rig never reads SNMP community names, which work like passwords", "keys": ["Services\\SNMP\\Parameters"] },
    { "says": "Rig never reads browsers' own settings, which hold sign-ins and history", "keys": ["Software\\Google\\Chrome", "Software\\WOW6432Node\\Google\\Chrome", "Software\\Microsoft\\Edge", "Software\\WOW6432Node\\Microsoft\\Edge", "Software\\Mozilla", "Software\\BraveSoftware", "Software\\Opera Software", "Software\\Microsoft\\Internet Explorer\\IntelliForms"] },
    { "says": "Rig never reads saved credentials or the credential vault", "keys": ["Credentials", "Vault", "Protected Storage System Provider", "Microsoft\\Protect"] }
  ],
  "secretValue": ["password", "passwd", "pwd", "secret", "token", "credential", "passphrase"],
  "keyValue": ["key"],
  "keyMinBytes": 16,
  "keyMinChars": 24
}
