{
  "version": 1,
  "about": "What the chat's live reads may look at. One table for the server, the app (packages/core/src/reads.ts) and the helper (helper/RigHelper/Reads.cs). Names match case-insensitively. `cim`: the only classes Rig reads, by namespace; a class not listed is refused. `clean`: its values are facts Windows or the hardware report, so reading it isn't outside text; every other read counts as outside text (taint). `text`: properties of a clean class that hold free text others can write; asking for one, or for all properties, counts as outside text. `deny`: properties never read, and left out of a read of the whole class. `secretProperty`: property names that are never read in any class (a part of the name is enough). `registryClean`: keys whose values are settings, not outside text, with everything under them; with `values`, only those values are clean, and reading the whole key isn't. `registryNever`: keys Rig never reads; one that starts with HKLM or HKCU must start the key, any other must be a run of whole parts anywhere in it. `secretValue`: value names left out of a whole key and refused alone (a part of the name is enough); `keyValue` names are left out too when their data is binary of at least `keyMinBytes` bytes, or text of at least `keyMinChars` characters that looks like base64 or hex.",
  "cim": {
    "root\\cimv2": {
      "Win32_Processor": { "clean": true },
      "Win32_ComputerSystem": { "clean": true },
      "Win32_ComputerSystemProduct": { "clean": true },
      "Win32_BaseBoard": { "clean": true },
      "Win32_BIOS": { "clean": true },
      "Win32_SystemEnclosure": { "clean": true },
      "Win32_PhysicalMemory": { "clean": true },
      "Win32_PhysicalMemoryArray": { "clean": true },
      "Win32_CacheMemory": { "clean": true },
      "Win32_DiskDrive": { "clean": true },
      "Win32_DiskPartition": { "clean": true },
      "Win32_LogicalDisk": { "clean": true, "text": ["VolumeName"] },
      "Win32_Volume": { "clean": true, "text": ["Label"] },
      "Win32_VideoController": { "clean": true },
      "Win32_DesktopMonitor": { "clean": true },
      "Win32_SoundDevice": { "clean": true },
      "Win32_Fan": { "clean": true },
      "Win32_TemperatureProbe": { "clean": true },
      "Win32_Battery": { "clean": true },
      "Win32_PortableBattery": { "clean": true },
      "Win32_USBController": { "clean": true },
      "Win32_USBHub": { "clean": true },
      "Win32_Keyboard": { "clean": true },
      "Win32_PointingDevice": { "clean": true },
      "Win32_IDEController": { "clean": true },
      "Win32_SCSIController": { "clean": true },
      "Win32_OnBoardDevice": { "clean": true },
      "Win32_NetworkAdapter": { "clean": true },
