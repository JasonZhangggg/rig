      "Win32_PnPEntity": { "clean": true },
      "Win32_PnPSignedDriver": { "clean": true },
      "Win32_SystemDriver": { "clean": true, "text": ["Description", "PathName"] },
      "Win32_Service": { "clean": true, "text": ["Description", "PathName"] },
      "Win32_OperatingSystem": { "clean": true },
      "Win32_QuickFixEngineering": { "clean": true },
      "Win32_OptionalFeature": { "clean": true },
      "Win32_TimeZone": { "clean": true },
      "Win32_PageFileUsage": { "clean": true },
      "Win32_PageFileSetting": { "clean": true },
      "Win32_OSRecoveryConfiguration": { "clean": true },
      "Win32_BootConfiguration": { "clean": true },
      "Win32_PerfFormattedData_PerfOS_Processor": { "clean": true },
      "Win32_PerfFormattedData_PerfOS_Memory": { "clean": true },
      "Win32_PerfFormattedData_PerfDisk_PhysicalDisk": { "clean": true },
      "Win32_PerfFormattedData_Tcpip_NetworkInterface": { "clean": true },
      "Win32_NTLogEvent": {},
      "Win32_ReliabilityRecords": {},
      "Win32_Process": { "deny": ["CommandLine"] },
      "Win32_StartupCommand": {},
      "Win32_Printer": {},
      "Win32_Share": {}
    },
    "root\\cimv2\\power": {
