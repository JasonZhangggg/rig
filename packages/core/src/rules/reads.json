      "Win32_PowerSetting": { "clean": true },
      "Win32_PowerSettingSubgroup": { "clean": true },
      "Win32_PowerSettingDataIndex": { "clean": true }
    },
    "root\\cimv2\\Security\\MicrosoftTpm": {
