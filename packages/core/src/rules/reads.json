      "WmiMonitorConnectionParams": { "clean": true },
      "WmiMonitorBrightness": { "clean": true },
      "MSAcpi_ThermalZoneTemperature": { "clean": true },
      "MS_SystemInformation": { "clean": true },
      "BatteryStatus": { "clean": true },
      "BatteryStaticData": { "clean": true },
      "BatteryFullChargedCapacity": { "clean": true },
      "BatteryCycleCount": { "clean": true }
    },
    "root\\StandardCimv2": {
