    { "provider": "Microsoft-Windows-Kernel-General", "ids": [13], "says": "Windows shut down", "fields": {} },
    { "provider": "Microsoft-Windows-Kernel-Power", "ids": [42], "says": "went to sleep", "fields": { "reason": { "from": ["Reason"], "type": "int" }, "state": { "from": ["TargetState"], "type": "int" } } },
    { "provider": "Microsoft-Windows-Kernel-Power", "ids": [107], "says": "woke from sleep", "fields": {} },
