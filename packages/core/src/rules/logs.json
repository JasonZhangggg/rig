    { "provider": "Microsoft-Windows-Windows Defender", "ids": [1116, 1117], "says": "Defender found a threat (1116) or acted on it (1117)", "fields": { "threat": { "from": ["Threat Name"], "type": "name" }, "severity": { "from": ["Severity Name"], "type": "name" }, "file": { "from": ["Path"], "type": "file" }, "action": { "from": ["Action Name"], "type": "name" } } },
    { "provider": "Microsoft-Windows-Windows Defender", "ids": [5000], "says": "Defender's real-time protection was turned on", "fields": {} },
