{
  "version": 2,
  "about": "What the chat's log reads (read_pc kind log) may look at. One table for the server, the app (packages/core/src/logReads.ts) and the helper (helper/RigHelper/LogReads.cs). Every log is read only and needs no approval, so any event log channel can be read; what keeps a read small is `limits`. `topics`: for each kind of change Rig can make (`for`, the step kinds in propose_change), the event log queries that show it happening or going wrong, and the other log sources (`also`) worth reading with it. A query names a `channel` and may narrow it to `providers`, event `ids` and `levels` (1 critical, 2 error, 3 warning, 4 info, 5 verbose). `files`: log files by key, at a fixed `path`, or the newest file matching `match` in a `folder`; %windir%, %ProgramData%, %ProgramFiles%, %SystemDrive% and %LocalAppData% (the person's own, never the helper's) are filled in on the PC, and `format` setupapi reads it as one install per section. `vendors`: folders where graphics and PC makers' tools keep their logs; only files ending in one of `vendorExtensions` are listed or read. `bugchecks`: stop codes' names, for crash dumps. `esrtStatus`: what a firmware update's LastAttemptStatus means. Reads that count as clean (not outside text) are only `clean` sources: their answers are numbers, times and names Windows itself writes. A clean source with `textTaints` is clean only without `text`: its answer then holds each event's time, source, id, level, what it means (`facts`' `says`) and its facts, never its message. `facts`: for an event `provider` and `ids`, which of its fields (`from`: the EventData or UserData names to try, or #n for the nth value) to give and as which of `factTypes`; the helper keeps only values that fit the type, and the server checks them again, so a fact can't carry an app's own text.",
  "limits": {
    "defaultHours": 72,
    "defaultLongHours": 720,
    "maxHours": 2160,
    "defaultMax": 30,
    "maxEvents": 100,
    "maxFiles": 40,
    "defaultLines": 60,
    "maxLines": 200,
    "messageChars": 300,
    "lineChars": 300,
    "textChars": 7500,
    "scanBytes": 8388608,
    "examine": 3000,
    "providers": 8,
    "ids": 24,
    "containsChars": 100
  },
  "sources": {
    "events": { "says": "one event log channel, any of Windows' or an app's, newest first: each event's facts, or its message too with text", "clean": true, "textTaints": true },
    "topic": { "says": "the events that show one kind of change happening or going wrong, from every channel that logs it", "clean": true, "textTaints": true },
    "channels": { "says": "the event log channels whose names hold a word, with how many events each has and whether it's on", "clean": false },
    "crashes": { "says": "blue screen dumps (C:\\Windows\\Minidump and MEMORY.DMP) and live kernel reports (driver hangs and graphics resets Windows recovered from), with each one's stop code", "clean": true },
    "wer": { "says": "Windows Error Reporting's reports of apps that crashed or hung: the app, the faulting module and the exception", "clean": true },
    "reliability": { "says": "Reliability Monitor's records (installs, crashes, failed updates) and its stability index", "clean": true, "textTaints": true },
    "file": { "says": "a log file Rig knows by name", "clean": false },
    "vendor": { "says": "the log files a graphics or PC maker's tools keep, listed newest first, or one of them read", "clean": false },
    "esrt": { "says": "the firmware (BIOS) and device firmware versions Windows can update, with how the last update went", "clean": true }
  },
  "topics": {
    "crashes": {
      "says": "blue screens, unexpected restarts, and app crashes and hangs",
      "for": ["fix", "recipe", "registry", "service", "policy", "device", "driver", "app", "gpu", "fileEdit", "firmware", "command"],
      "queries": [
        { "channel": "System", "providers": ["Microsoft-Windows-WER-SystemErrorReporting"], "ids": [1001] },
        { "channel": "System", "providers": ["Microsoft-Windows-Kernel-Power"], "ids": [41] },
        { "channel": "System", "providers": ["EventLog"], "ids": [6008] },
        { "channel": "Application", "providers": ["Application Error", "Application Hang", "Windows Error Reporting", ".NET Runtime"], "ids": [1000, 1001, 1002, 1026] }
      ],
      "also": ["crashes", "wer", "reliability"]
    },
    "gpu": {
      "says": "graphics driver resets, timeouts and errors",
      "for": ["gpu", "driver", "app", "screen"],
      "queries": [
        { "channel": "System", "providers": ["Display"], "ids": [4101] },
        { "channel": "System", "providers": ["nvlddmkm", "amdkmdag", "amdwddmg", "atikmdag", "igfx", "igfxn", "dxgkrnl", "Microsoft-Windows-DxgKrnl"] },
        { "channel": "Microsoft-Windows-DxgKrnl-Admin" },
        { "channel": "Microsoft-Windows-DxgKrnl-Operational", "levels": [1, 2, 3] }
      ],
      "also": ["crashes", "vendor"]
    },
    "drivers": {
      "says": "driver and device installs, devices failing to start or turned off and on, and drivers Windows blocked",
      "for": ["driver", "device", "gpu"],
      "queries": [
        { "channel": "System", "providers": ["Microsoft-Windows-UserPnp"], "ids": [20001, 20003] },
        { "channel": "Microsoft-Windows-Kernel-PnP/Configuration" },
        { "channel": "Microsoft-Windows-DeviceSetupManager/Admin" },
        { "channel": "Microsoft-Windows-CodeIntegrity/Operational", "levels": [1, 2, 3] },
        { "channel": "Microsoft-Windows-DriverFrameworks-UserMode/Operational", "levels": [1, 2, 3] }
      ],
      "also": ["setupapi"]
    },
    "updates": {
      "says": "Windows updates found, installed or failed, and Windows feature installs",
      "for": ["command", "app", "driver", "firmware"],
      "queries": [
        { "channel": "System", "providers": ["Microsoft-Windows-WindowsUpdateClient", "Microsoft-Windows-Servicing"] },
        { "channel": "Microsoft-Windows-WindowsUpdateClient/Operational" },
        { "channel": "Setup" }
      ],
      "also": ["reportingevents", "cbs", "dism"]
    },
    "apps": {
      "says": "app installs, updates and uninstalls (Windows Installer and Store apps)",
      "for": ["app", "command"],
      "queries": [
        { "channel": "Application", "providers": ["MsiInstaller"], "ids": [1033, 1034, 1035, 1036, 11707, 11708, 11724, 11728] },
        { "channel": "Microsoft-Windows-AppXDeploymentServer/Operational", "levels": [1, 2, 3] }
      ],
      "also": ["winget", "wer"]
    },
    "services": {
      "says": "services that failed or stopped, had how they start changed, or were added",
      "for": ["service", "recipe", "command", "protection"],
      "queries": [
        { "channel": "System", "providers": ["Service Control Manager"], "ids": [7000, 7001, 7009, 7011, 7022, 7023, 7024, 7026, 7031, 7032, 7034, 7040, 7045] }
      ],
      "also": []
    },
    "firewall": {
      "says": "firewall rules added, changed or removed, firewall settings changed, and blocked connections when auditing is on",
      "for": ["firewall", "protection", "command"],
      "queries": [
        { "channel": "Microsoft-Windows-Windows Firewall With Advanced Security/Firewall" },
        { "channel": "Security", "ids": [4946, 4947, 4948, 4950, 5025, 5030, 5152, 5157] }
      ],
      "also": ["pfirewall"]
    },
    "protection": {
      "says": "Defender's protection turned off or on, its settings changed and threats it found, SmartScreen, and Security Center",
      "for": ["protection", "policy", "registry", "command"],
      "queries": [
        { "channel": "Microsoft-Windows-Windows Defender/Operational", "ids": [1006, 1007, 1015, 1116, 1117, 1118, 1119, 5000, 5001, 5004, 5007, 5008, 5010, 5012] },
        { "channel": "Microsoft-Windows-SmartScreen/Debug" },
        { "channel": "Application", "providers": ["SecurityCenter"] }
      ],
      "also": []
    },
    "power": {
      "says": "shutdowns, restarts, sleep and wake, power plan changes, and slow starts and shutdowns",
      "for": ["fix", "recipe", "firmware", "command"],
      "queries": [
        { "channel": "System", "providers": ["Microsoft-Windows-Kernel-Power"], "ids": [41, 42, 105, 107, 109, 172, 506, 507] },
        { "channel": "System", "providers": ["Microsoft-Windows-Kernel-General"], "ids": [1, 12, 13] },
        { "channel": "System", "providers": ["Microsoft-Windows-Power-Troubleshooter"], "ids": [1] },
        { "channel": "System", "providers": ["Microsoft-Windows-UserModePowerService"], "ids": [12] },
        { "channel": "System", "providers": ["User32"], "ids": [1074] },
        { "channel": "System", "providers": ["EventLog"], "ids": [6005, 6006, 6008] },
        { "channel": "Microsoft-Windows-Diagnostics-Performance/Operational", "ids": [100, 101, 102, 103, 106, 109, 200, 203] }
      ],
      "also": []
    },
    "firmware": {
      "says": "what the firmware reported at start-up: Secure Boot, the security chip (TPM), drive encryption asking for its recovery key, and firmware errors",
      "for": ["firmware"],
      "queries": [
        { "channel": "System", "providers": ["Microsoft-Windows-Kernel-Boot", "Microsoft-Windows-TPM-WMI", "TPM", "Microsoft-Windows-WHEA-Logger", "ACPI"] },
        { "channel": "Microsoft-Windows-Kernel-Boot/Operational", "levels": [1, 2, 3] },
        { "channel": "Microsoft-Windows-BitLocker/BitLocker Management" }
      ],
      "also": ["esrt", "vendor"]
    },
    "hardware": {
      "says": "hardware errors the processor, memory or PCIe reported (fixed or not), and Windows' memory test results",
      "for": ["firmware", "fix", "gpu"],
      "queries": [
        { "channel": "System", "providers": ["Microsoft-Windows-WHEA-Logger", "Microsoft-Windows-MemoryDiagnostics-Results"] },
        { "channel": "Microsoft-Windows-Kernel-WHEA/Errors" }
      ],
      "also": ["crashes"]
    },
    "storage": {
      "says": "disk, file system and storage controller errors and retries",
      "for": ["command", "fix", "driver"],
      "queries": [
        { "channel": "System", "providers": ["disk", "Ntfs", "Microsoft-Windows-Ntfs", "volmgr", "stornvme", "storahci", "iaStorAC", "Microsoft-Windows-StorPort"] },
        { "channel": "Microsoft-Windows-Storage-Storport/Operational", "levels": [1, 2, 3] },
        { "channel": "Microsoft-Windows-Ntfs/Operational", "levels": [1, 2, 3] }
      ],
      "also": []
    },
    "settings": {
      "says": "Group Policy applying or failing, and scheduled tasks added, changed or failing",
      "for": ["registry", "policy", "recipe", "fileEdit", "screen", "command"],
      "queries": [
        { "channel": "Microsoft-Windows-GroupPolicy/Operational", "levels": [1, 2, 3] },
        { "channel": "System", "providers": ["Microsoft-Windows-GroupPolicy"] },
        { "channel": "Microsoft-Windows-TaskScheduler/Operational", "ids": [101, 103, 106, 140, 141, 142, 201, 202, 203] }
      ],
      "also": []
    },
    "network": {
      "says": "network adapter, Wi-Fi, address and name lookup trouble, and networks switching between public and private",
      "for": ["firewall", "command", "device", "driver"],
      "queries": [
        { "channel": "System", "providers": ["Tcpip", "Microsoft-Windows-Dhcp-Client", "Microsoft-Windows-DNS-Client", "Microsoft-Windows-NDIS"], "levels": [1, 2, 3] },
        { "channel": "Microsoft-Windows-WLAN-AutoConfig/Operational", "levels": [1, 2, 3] },
        { "channel": "Microsoft-Windows-NetworkProfile/Operational" }
      ],
      "also": []
    }
  },
  "files": {
    "setupapi": { "says": "every driver and device install: which driver Windows picked, from where, and whether it worked", "path": "%windir%\\INF\\setupapi.dev.log", "format": "setupapi" },
    "setupapi-app": { "says": "driver installs that came with an app's own installer", "path": "%windir%\\INF\\setupapi.app.log", "format": "setupapi" },
    "cbs": { "says": "Windows' servicing log: updates and Windows features installed, and repairs (sfc)", "path": "%windir%\\Logs\\CBS\\CBS.log" },
    "dism": { "says": "DISM's log of Windows image checks and repairs", "path": "%windir%\\Logs\\DISM\\dism.log" },
    "reportingevents": { "says": "Windows Update's history: each update, when, and its result code", "path": "%windir%\\SoftwareDistribution\\ReportingEvents.log" },
    "panther": { "says": "Windows upgrades and feature updates (setup's own log)", "path": "%windir%\\Panther\\setupact.log" },
    "srt": { "says": "Startup Repair's last run", "path": "%windir%\\System32\\LogFiles\\Srt\\SrtTrail.txt" },
    "pfirewall": { "says": "the firewall's own log of dropped and allowed connections, when its logging is on", "path": "%windir%\\System32\\LogFiles\\Firewall\\pfirewall.log" },
    "winget": { "says": "winget's newest log: app installs, updates and uninstalls Rig ran, and why one failed", "folder": "%LocalAppData%\\Packages\\Microsoft.DesktopAppInstaller_8wekyb3d8bbwe\\LocalState\\DiagOutputDir", "match": ".log" },
    "rig": { "says": "the Rig app's own log on this PC: the helper, sensors, sync and updates", "path": "%LocalAppData%\\app.rig.desktop\\logs\\Rig.log" }
  },
  "vendors": {
    "nvidia": { "name": "NVIDIA", "folders": ["%ProgramData%\\NVIDIA Corporation", "%ProgramData%\\NVIDIA", "%LocalAppData%\\NVIDIA Corporation", "%LocalAppData%\\NVIDIA"] },
    "amd": { "name": "AMD", "folders": ["%SystemDrive%\\AMD", "%ProgramFiles%\\AMD\\CIM\\Log", "%ProgramData%\\AMD", "%LocalAppData%\\AMD"] },
    "intel": { "name": "Intel", "folders": ["%ProgramData%\\Intel", "%SystemDrive%\\Intel\\Logs", "%LocalAppData%\\Intel"] },
    "dell": { "name": "Dell", "folders": ["%ProgramData%\\Dell", "%ProgramData%\\Dell Inc"] },
    "hp": { "name": "HP", "folders": ["%ProgramData%\\HP", "%ProgramData%\\Hewlett-Packard"] },
    "lenovo": { "name": "Lenovo", "folders": ["%ProgramData%\\Lenovo", "%LocalAppData%\\Lenovo"] }
  },
  "vendorExtensions": [".log", ".txt"],
  "vendorDepth": 5,
  "facts": [
    { "provider": "Microsoft-Windows-Kernel-Power", "ids": [41], "says": "restarted without shutting down cleanly (no stopCode: not a blue screen; powerButton above 0: the power button was held)", "fields": { "stopCode": { "from": ["BugcheckCode"], "type": "stop" }, "param1": { "from": ["BugcheckParameter1"], "type": "hex" }, "sleeping": { "from": ["SleepInProgress"], "type": "int" }, "powerButton": { "from": ["PowerButtonTimestamp"], "type": "int" } } },
    { "provider": "EventLog", "ids": [6008], "says": "the shutdown before was unexpected", "fields": {} },
    { "provider": "Microsoft-Windows-WER-SystemErrorReporting", "ids": [1001], "says": "restarted after a blue screen", "fields": { "stopCode": { "from": ["param1", "#0"], "type": "stop" } } },
    { "provider": "Microsoft-Windows-WHEA-Logger", "ids": [17, 18, 19, 46, 47], "says": "the hardware reported an error (18 and 46: one Windows couldn't correct)", "fields": { "errorSource": { "from": ["ErrorSource"], "type": "int" }, "apicId": { "from": ["ApicId"], "type": "int" }, "bank": { "from": ["MCABank"], "type": "int" }, "errorType": { "from": ["ErrorType"], "type": "int" } } },
    { "provider": "Display", "ids": [4101], "says": "the graphics driver stopped responding and recovered", "fields": { "driver": { "from": ["#0"], "type": "id" } } },
    { "provider": "Microsoft-Windows-Kernel-PnP", "ids": [219], "says": "a driver didn't load", "fields": { "driver": { "from": ["DriverName"], "type": "id" }, "status": { "from": ["Status"], "type": "hex" } } },
    { "provider": "Service Control Manager", "ids": [7000, 7009, 7011, 7023, 7024, 7031, 7034], "says": "a service didn't start, stopped unexpectedly or failed", "fields": { "service": { "from": ["param1", "#0"], "type": "name" } } },
    { "provider": "Service Control Manager", "ids": [7036], "says": "a service started or stopped", "fields": { "service": { "from": ["param1", "#0"], "type": "name" }, "state": { "from": ["param2", "#1"], "type": "name" } } },
    { "provider": "Service Control Manager", "ids": [7040], "says": "a service's start type changed", "fields": { "service": { "from": ["param1", "#0"], "type": "name" }, "was": { "from": ["param2", "#1"], "type": "name" }, "now": { "from": ["param3", "#2"], "type": "name" }, "key": { "from": ["param4", "#3"], "type": "id" } } },
    { "provider": "Service Control Manager", "ids": [7045], "says": "a service was installed", "fields": { "service": { "from": ["ServiceName"], "type": "name" }, "file": { "from": ["ImagePath"], "type": "file" }, "start": { "from": ["StartType"], "type": "name" } } },
    { "provider": "Microsoft-Windows-WindowsUpdateClient", "ids": [19], "says": "an update installed", "fields": { "kb": { "from": ["updateTitle"], "type": "kb" }, "update": { "from": ["updateGuid"], "type": "guid" } } },
    { "provider": "Microsoft-Windows-WindowsUpdateClient", "ids": [20], "says": "an update failed to install", "fields": { "kb": { "from": ["updateTitle"], "type": "kb" }, "update": { "from": ["updateGuid"], "type": "guid" }, "error": { "from": ["errorCode"], "type": "hex" } } },
    { "provider": "Microsoft-Windows-WindowsUpdateClient", "ids": [43], "says": "an update started installing", "fields": { "kb": { "from": ["updateTitle"], "type": "kb" } } },
    { "provider": "Microsoft-Windows-WindowsUpdateClient", "ids": [44], "says": "an update started downloading", "fields": { "kb": { "from": ["updateTitle"], "type": "kb" } } },
    { "provider": "Microsoft-Windows-UserPnp", "ids": [20001, 20003], "says": "a driver was installed for a device (status 0x00000000: it worked)", "fields": { "device": { "from": ["DeviceInstanceID"], "type": "id" }, "driver": { "from": ["DriverName"], "type": "file" }, "version": { "from": ["DriverVersion"], "type": "version" }, "maker": { "from": ["DriverProvider"], "type": "name" }, "status": { "from": ["InstallStatus"], "type": "hex" } } },
    { "provider": "Microsoft-Windows-Kernel-PnP", "ids": [400, 410, 411, 420, 430], "says": "a device was set up (400), started (410), failed to start (411) or had its driver changed", "fields": { "device": { "from": ["DeviceInstanceId"], "type": "id" }, "driver": { "from": ["DriverName"], "type": "file" }, "version": { "from": ["DriverVersion"], "type": "version" }, "maker": { "from": ["DriverProvider"], "type": "name" }, "status": { "from": ["Status"], "type": "hex" }, "problem": { "from": ["Problem"], "type": "int" } } },
    { "provider": "Disk", "ids": [7, 51, 153], "says": "the disk had a bad block (7), a paging error (51) or retried a read or write (153)", "fields": { "device": { "from": ["#0"], "type": "id" } } },
    { "provider": "Microsoft-Windows-Ntfs", "ids": [55, 98, 140], "says": "the file system found a problem on a drive", "fields": { "drive": { "from": ["DriveName", "VolumeName"], "type": "name" }, "device": { "from": ["DeviceName"], "type": "id" } } },
    { "provider": "Microsoft-Windows-Kernel-Boot", "ids": [27], "says": "Windows started", "fields": { "bootType": { "from": ["BootType"], "type": "int" } } },
