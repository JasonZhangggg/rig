    { "provider": "Microsoft-Windows-Kernel-Processor-Power", "ids": [37], "says": "the firmware limited the processor's speed", "fields": {} },
    { "provider": "Microsoft-Windows-Resource-Exhaustion-Detector", "ids": [2004], "says": "Windows ran low on memory", "fields": {} },
    { "provider": "Microsoft-Windows-WLAN-AutoConfig", "ids": [8001], "says": "Wi-Fi connected", "fields": { "network": { "from": ["SSID"], "type": "name" } } },
    { "provider": "Microsoft-Windows-WLAN-AutoConfig", "ids": [8002, 8003, 11004, 11005, 11006, 11010], "says": "Wi-Fi didn't connect or disconnected", "fields": { "network": { "from": ["SSID"], "type": "name" }, "reason": { "from": ["ReasonCode"], "type": "int" } } },
    { "provider": "Application Error", "ids": [1000], "says": "an app crashed", "fields": { "app": { "from": ["AppName", "#0"], "type": "file" }, "appVersion": { "from": ["AppVersion", "#1"], "type": "version" }, "module": { "from": ["ModuleName", "#3"], "type": "file" }, "moduleVersion": { "from": ["ModuleVersion", "#4"], "type": "version" }, "exception": { "from": ["ExceptionCode", "#6"], "type": "hex" }, "offset": { "from": ["FaultingOffset", "#7"], "type": "hex" } } },
